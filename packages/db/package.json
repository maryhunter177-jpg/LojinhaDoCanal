{
  "name": "@ofertas/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "node --import tsx --env-file=../../.env node_modules/drizzle-kit/bin.cjs generate",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "seed": "tsx --env-file=../../.env src/seed.ts"
  },
  "dependencies": {
    "@ofertas/core": "workspace:*",
    "drizzle-orm": "0.44.7",
    "pg": "8.16.3",
    "pino": "9.14.0"
  },
  "devDependencies": {
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.8"
  }
}
